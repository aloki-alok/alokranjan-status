{
  "name": "alokranjan-status",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun scripts/build.ts",
    "lint": "bunx biome check .",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun scripts/check.ts",
    "deploy": "bun run check && bunx wrangler deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.4.1",
    "typescript": "5.9.3",
    "wrangler": "4.130.0"
  }
}
